# Обязательные
TELEGRAM_BOT_TOKEN=123456:ABC...
# Enable only after migrating the main bot with logOut; otherwise leave empty (cloud API).
TELEGRAM_API_BASE=
BUYTOKENS_API_KEY=sk-...

# Необязательные (показаны значения по умолчанию)
BUYTOKENS_BASE_URL=https://api.example.invalid/v1
# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=
# whitelist: новые пользователи ждут одобрения админа; open: доступ всем
ACCESS_MODE=whitelist
DAILY_REQUEST_LIMIT=100
MAX_CONCURRENCY=5
HISTORY_TOKEN_BUDGET=2000000
# Часов тишины в диалоге до тихого сброса контекста (без уведомления); 0 выключает.
CONTEXT_IDLE_HOURS=24
DB_PATH=data/bot.db
LOG_LEVEL=INFO

# --- Отдельный админ-бот (python -m adminbot) ---
# Токен второго бота от @BotFather. Без него админ-бот не запускается, а заявки
# на доступ приходят в основной бот. База у обоих одна и та же (DB_PATH).
ADMIN_BOT_TOKEN=
# Часовой пояс админ-бота: времена в панели и «сегодня» считаются в нём.
# Дневная квота основного бота по-прежнему сбрасывается в 00:00 UTC.
ADMIN_UTC_OFFSET=3

# --- Стоимость и внешние квоты (для панели) ---
# Цена за 1 млн токенов; конкретную модель можно переопределить в models.yaml (price:).
TOKEN_PRICE=0.01
PRICE_CURRENCY=$
# Бесплатные лимиты внешних сервисов: показываются в «Состоянии» и в оповещениях.
CLOUDFLARE_DAILY_NEURONS=10000

# --- Оповещения админу (0 или -1 выключает) ---
# Провалы шлюза за 15 минут, после которых приходит тревога.
ALERT_FAILED_COUNT=5
# Токенов за сутки на одного пользователя, после которых приходит тревога.
ALERT_USER_TOKENS=1000000
# Час местного времени для ежедневной сводки; -1 выключает.
DAILY_REPORT_HOUR=9

# --- Интернет и картинки (скиллы скрываются, если ключей нет) ---
# Свой SearXNG на сервере (служба searxng): поиск без лимитов и ключей.
SEARXNG_URL=
# Запасной поиск Google (serper.dev, $1 за 1000): только когда SearXNG упал или ничего не нашёл.
SERPER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Голосовые сообщения (faster-whisper) ---
# tiny/base/small/medium; пусто выключает распознавание.
STT_MODEL=small
STT_MODELS_DIR=data/models
STT_MAX_SECONDS=300

# --- Аварийный резерв и проверка моделей (OmniRoute Free Kit) ---
# Без RESERVE_BASE_URL аварийный переключатель скрыт в панели, бот всегда ходит в BuyTokens.
RESERVE_BASE_URL=
RESERVE_API_KEY=
# Комбо OmniRoute — самая сильная бесплатная модель, отвечающая за всех.
RESERVE_MODEL=free-coded
# Бесплатные модели держат меньший контекст, чем основной шлюз.
RESERVE_TOKEN_BUDGET=100000
# Как часто админ-бот сам проверяет все модели тестовым запросом; 0 выключает проверку и её тревоги.
MODEL_PROBE_MINUTES=15
